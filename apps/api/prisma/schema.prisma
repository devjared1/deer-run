generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  role         Role          @default(MEMBER)
  supabaseId   String?       @unique
  bookings     Booking[]
  employee     Employee?
  purchases    Sale[]
  houseAccount HouseAccount?
  createdAt    DateTime      @default(now())

  // Memberships sold at the register (POS Phase 6). memberUntil null = no expiry (members added
  // by hand before memberships were sold through the POS). Lapsed members drop to GUEST.
  memberUntil        DateTime? @db.Date
  membershipTier     String? // "Individual" | "Premier" | "Family" (membershipTiers.js)
  renewalReminderKey String? // "<memberUntil>:<30|7|expired>" of the last reminder email sent
}

enum Role {
  GUEST
  MEMBER
  ADMIN
}

model TeeTimeSlot {
  id         String    @id @default(cuid())
  date       DateTime  @db.Date
  startTime  String
  maxPlayers Int       @default(4)
  memberOnly Boolean   @default(false)
  bookings   Booking[]
  createdAt  DateTime  @default(now())

  @@unique([date, startTime])
}

model Booking {
  id              String        @id @default(cuid())
  teeTimeSlot     TeeTimeSlot   @relation(fields: [teeTimeSlotId], references: [id])
  teeTimeSlotId   String
  user            User?         @relation(fields: [userId], references: [id])
  userId          String?
  guestName       String?
  guestEmail      String?
  players         Int
  totalCents      Int
  status          BookingStatus @default(PENDING)
  stripeSessionId String?       @unique
  stripePaymentId String?
  source          BookingSource @default(ONLINE)
  checkedInAt     DateTime? // set when the group checks in at the pro shop
  saleItems       SaleItem[]
  createdAt       DateTime      @default(now())
}

enum BookingSource {
  ONLINE
  POS // walk-in booked at the register
  PHONE // phone booking entered (and paid) at the register
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

model CourseSettings {
  id                  String @id @default("singleton")
  publicBookingDays   Int    @default(7)
  memberBookingDays   Int    @default(14)
  pricePerPlayerCents Int    @default(4500)
  firstTeeTime        String @default("07:30")
  lastTeeTime         String @default("17:00")
  intervalMinutes     Int    @default(10)

  // Payroll: pay periods are payPeriodDays long, counted from payPeriodAnchor (any date that
  // starts a pay period). The workweek for overtime starts on the anchor's weekday.
  payPeriodDays   Int      @default(14)
  payPeriodAnchor DateTime @default(dbgenerated("'2026-01-04'::date")) @db.Date // a Sunday

  // POS: one course-wide sales tax rate in basis points (900 = 9.00%). 0 until an admin sets it.
  salesTaxBps       Int                @default(900)
  // Positions allowed to ring sales, and positions that can approve No Sale / voids / refunds
  registerPositions EmployeePosition[] @default([GENERAL_MANAGER, HEAD_GOLF_PROFESSIONAL, ASSISTANT_GOLF_PROFESSIONAL, PRO_SHOP_ATTENDANT, STARTER, FOOD_BEVERAGE_MANAGER, SERVER])
  managerPositions  EmployeePosition[] @default([GENERAL_MANAGER, HEAD_GOLF_PROFESSIONAL, SUPERINTENDENT, FOOD_BEVERAGE_MANAGER])
}

model TournamentEvent {
  id          String   @id @default(cuid())
  name        String
  description String
  eventDate   DateTime
  startTime   String
  format      String
  entry       Int?
  spotsTotal  Int?
  memberOnly  Boolean  @default(false)
  featured    Boolean  @default(false)
  past        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Inquiry {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  tier      String
  message   String?
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

// ─── Employee time management ────────────────────────────────────────────────

enum EmployeePosition {
  GENERAL_MANAGER
  HEAD_GOLF_PROFESSIONAL
  ASSISTANT_GOLF_PROFESSIONAL
  PRO_SHOP_ATTENDANT
  STARTER
  PLAYER_ASSISTANT
  OUTSIDE_SERVICES
  SUPERINTENDENT
  ASSISTANT_SUPERINTENDENT
  GROUNDS_CREW
  EQUIPMENT_TECHNICIAN
  FOOD_BEVERAGE_MANAGER
  COOK
  SERVER
  BEVERAGE_CART_ATTENDANT
}

enum TimeOffType {
  VACATION
  SICK
  PERSONAL
  UNPAID
}

enum TimeOffStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

// An employee is linked to a login (User) by email so they can clock in and view
// their schedule. Admin panel access comes from User.role = ADMIN; register managers are employees
// whose position is in CourseSettings.managerPositions.
model Employee {
  id              String           @id @default(cuid())
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          String?          @unique
  firstName       String
  lastName        String
  email           String           @unique
  phone           String?
  position        EmployeePosition
  hourlyRateCents Int?
  hireDate        DateTime?        @db.Date
  active          Boolean          @default(true)
  timeEntries     TimeEntry[]
  shifts          Shift[]
  timeOffRequests TimeOffRequest[]
  sales           Sale[]
  refunds         SaleRefund[]
  createdAt       DateTime         @default(now())

  // Register manager PIN (PBKDF2 hash, never returned by the API) and lockout after wrong tries
  managerPinHash           String?
  managerPinFailedAttempts Int                 @default(0)
  managerPinLockedUntil    DateTime?
  approvalsGiven           ManagerApproval[]   @relation("ApprovalApprover")
  approvalsReceived        ManagerApproval[]   @relation("ApprovalCashier")
  drawersOpened            CashDrawerSession[] @relation("DrawerOpenedBy")
  drawersClosed            CashDrawerSession[] @relation("DrawerClosedBy")
  cardCheckouts            CardCheckout[]
}

// One clock-in/clock-out pair. clockOut is null while the employee is on the clock;
// the API allows at most one open entry per employee.
model TimeEntry {
  id         String      @id @default(cuid())
  employee   Employee    @relation(fields: [employeeId], references: [id])
  employeeId String
  clockIn    DateTime
  clockOut   DateTime?
  breaks     TimeBreak[]
  note       String?
  editedById String? // User.id of the manager who last corrected this entry
  editedAt   DateTime?
  createdAt  DateTime    @default(now())

  @@index([employeeId, clockIn])
}

model TimeBreak {
  id          String    @id @default(cuid())
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  timeEntryId String
  startedAt   DateTime
  endedAt     DateTime?
}

// A scheduled shift. Times use the same "HH:MM" convention as TeeTimeSlot.
model Shift {
  id         String            @id @default(cuid())
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  date       DateTime          @db.Date
  startTime  String
  endTime    String
  position   EmployeePosition? // overrides the employee's position for this shift
  notes      String?
  createdAt  DateTime          @default(now())

  @@index([date])
}

model TimeOffRequest {
  id           String        @id @default(cuid())
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId   String
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  type         TimeOffType
  reason       String?
  status       TimeOffStatus @default(PENDING)
  reviewedById String? // User.id of the manager who approved/denied
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime      @default(now())

  @@index([employeeId, startDate])
}

// ─── Point of sale: catalog ──────────────────────────────────────────────────

// A table rather than an enum so admins can add categories and mark them tax-exempt
model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  taxExempt Boolean   @default(false)
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id               String           @id @default(cuid())
  category         ProductCategory  @relation(fields: [categoryId], references: [id])
  categoryId       String
  name             String
  description      String?
  priceCents       Int
  memberPriceCents Int? // null = members pay the regular price
  trackInventory   Boolean          @default(false)
  active           Boolean          @default(true)
  sortOrder        Int              @default(0)
  // Selling a product with membershipMonths makes the attached customer a member for that long
  membershipMonths Int?
  membershipTier   String?
  variants         ProductVariant[]
  createdAt        DateTime         @default(now())

  @@index([categoryId])
}

// What actually gets sold and stocked. Every product has at least one variant; products without
// sizes/colors have a single default variant (size and color null).
model ProductVariant {
  id               String                @id @default(cuid())
  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  size             String?
  color            String?
  sku              String?               @unique
  barcode          String?               @unique
  priceCents       Int? // overrides Product.priceCents
  memberPriceCents Int? // overrides Product.memberPriceCents
  stockQty         Int                   @default(0) // changed only through adjust_inventory()
  active           Boolean               @default(true)
  sortOrder        Int                   @default(0)
  adjustments      InventoryAdjustment[]
  saleItems        SaleItem[]
  createdAt        DateTime              @default(now())

  @@index([productId])
}

enum InventoryReason {
  INITIAL
  RECEIVED
  COUNT_CORRECTION
  DAMAGED
  RETURNED_TO_VENDOR
  OTHER
  SALE
  RETURN
}

// Stock change log. Restrict on delete: variants with stock history are deactivated, not deleted.
model InventoryAdjustment {
  id             String          @id @default(cuid())
  variant        ProductVariant  @relation(fields: [variantId], references: [id])
  variantId      String
  quantityChange Int
  stockAfter     Int
  reason         InventoryReason
  note           String?
  userId         String? // User.id of whoever made the change
  createdAt      DateTime        @default(now())

  @@index([variantId, createdAt])
}

// A checkout station (PC + printer + card reader). More can be added from the admin panel.
model Register {
  id             String              @id @default(cuid())
  name           String              @unique
  stripeReaderId String?             @unique
  active         Boolean             @default(true)
  sales          Sale[]
  refunds        SaleRefund[]
  approvals      ManagerApproval[]
  drawerSessions CashDrawerSession[]
  cardCheckouts  CardCheckout[]
  accountEntries HouseAccountEntry[]
  createdAt      DateTime            @default(now())
}

// ─── Point of sale: sales ────────────────────────────────────────────────────

enum SaleStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD_TERMINAL
  HOUSE_ACCOUNT
  PREPAID_ONLINE
  GIFT_CARD
}

// A completed checkout. Written only by the create_sale() Postgres function so the sale, its items,
// payments and stock changes save together. Amounts are snapshots: later price or tax changes
// never alter a past sale.
model Sale {
  id              String              @id @default(cuid())
  number          Int                 @unique @default(autoincrement()) // receipt number
  status          SaleStatus          @default(COMPLETED)
  register        Register            @relation(fields: [registerId], references: [id])
  registerId      String
  cashier         Employee            @relation(fields: [cashierId], references: [id])
  cashierId       String
  customer        User?               @relation(fields: [customerId], references: [id])
  customerId      String?
  isMemberPricing Boolean             @default(false)
  subtotalCents   Int // after line discounts, before tax
  discountCents   Int                 @default(0) // total of line discounts
  taxCents        Int
  totalCents      Int
  changeCents     Int                 @default(0) // cash handed back
  refundedCents   Int                 @default(0) // total of all refunds and voids
  receiptEmail    String?
  items           SaleItem[]
  payments        Payment[]
  refunds         SaleRefund[]
  approvals       ManagerApproval[]
  cardCheckout    CardCheckout?
  accountEntries  HouseAccountEntry[]
  createdAt       DateTime            @default(now())

  @@index([createdAt])
  @@index([registerId, createdAt])
  @@index([customerId])
}

model SaleItem {
  id             String          @id @default(cuid())
  sale           Sale            @relation(fields: [saleId], references: [id])
  saleId         String
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId      String? // null for a custom-amount item
  booking        Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  bookingId      String? // tee time this line is for (prepaid greens fee or walk-in/phone booking)
  description    String // product name + size/color at the time of sale
  categoryName   String?
  quantity       Int
  unitPriceCents Int
  discountCents  Int             @default(0)
  taxRateBps     Int // 0 for tax-exempt categories
  subtotalCents  Int // quantity × unit price − discount
  taxCents       Int
  totalCents     Int
  sortOrder      Int             @default(0)

  // Running totals of what has been refunded from this line
  refundedQuantity Int              @default(0)
  refundedCents    Int              @default(0)
  refundedTaxCents Int              @default(0)
  refundItems      SaleRefundItem[]

  @@index([saleId])
  @@index([variantId])
  @@index([bookingId])
}

model Payment {
  id                    String        @id @default(cuid())
  sale                  Sale          @relation(fields: [saleId], references: [id])
  saleId                String
  method                PaymentMethod
  amountCents           Int // applied to the sale
  tenderedCents         Int? // cash handed over (amount + change)
  stripePaymentIntentId String?       @unique
  createdAt             DateTime      @default(now())

  @@index([saleId])
}

// ─── Point of sale: manager approvals, voids and refunds ─────────────────────

enum ApprovalAction {
  DISCOUNT
  NO_SALE
  VOID
  REFUND
  CHANGE_REGISTER
}

// A manager's sign-off on a register action. Each approval is single-use and short-lived:
// the action that needs it marks it used (usedAt), linking the sale when there is one.
model ManagerApproval {
  id         String         @id @default(cuid())
  action     ApprovalAction
  approver   Employee       @relation("ApprovalApprover", fields: [approverId], references: [id])
  approverId String
  cashier    Employee       @relation("ApprovalCashier", fields: [cashierId], references: [id])
  cashierId  String
  register   Register?      @relation(fields: [registerId], references: [id])
  registerId String?
  sale       Sale?          @relation(fields: [saleId], references: [id])
  saleId     String?
  reason     String?
  expiresAt  DateTime
  usedAt     DateTime?
  refund     SaleRefund?
  createdAt  DateTime       @default(now())

  @@index([createdAt])
}

enum RefundKind {
  VOID // whole sale, same day
  REFUND // some or all items, any time
}

// Money returned on a sale. Written only by the refund_sale() Postgres function.
model SaleRefund {
  id             String              @id @default(cuid())
  sale           Sale                @relation(fields: [saleId], references: [id])
  saleId         String
  kind           RefundKind
  method         PaymentMethod // how the money went back
  amountCents    Int // including tax
  taxCents       Int
  restocked      Boolean
  reason         String
  stripeRefundId String?             @unique // card refunds: the Stripe refund (re_…)
  accountEntries HouseAccountEntry[]
  approval       ManagerApproval     @relation(fields: [approvalId], references: [id])
  approvalId     String              @unique
  cashier        Employee            @relation(fields: [cashierId], references: [id])
  cashierId      String
  register       Register            @relation(fields: [registerId], references: [id])
  registerId     String
  items          SaleRefundItem[]
  createdAt      DateTime            @default(now())

  @@index([saleId])
  @@index([createdAt])
}

model SaleRefundItem {
  id          String     @id @default(cuid())
  refund      SaleRefund @relation(fields: [refundId], references: [id])
  refundId    String
  saleItem    SaleItem   @relation(fields: [saleItemId], references: [id])
  saleItemId  String
  quantity    Int
  amountCents Int // including tax
  taxCents    Int

  @@index([refundId])
}

// ─── Point of sale: cash drawer sessions ─────────────────────────────────────

// A shift of a register's cash drawer: opened with a float, closed with a count. Expected cash is the
// float plus cash taken minus cash refunded at that register between openedAt and closedAt (worked out
// from Payment and SaleRefund, so sales don't need a session column). One open session per register
// (partial unique index CashDrawerSession_one_open_per_register, which Prisma can't model).
model CashDrawerSession {
  id                String    @id @default(cuid())
  register          Register  @relation(fields: [registerId], references: [id])
  registerId        String
  openedBy          Employee  @relation("DrawerOpenedBy", fields: [openedById], references: [id])
  openedById        String
  openedAt          DateTime  @default(now())
  openingFloatCents Int
  openNote          String?
  closedBy          Employee? @relation("DrawerClosedBy", fields: [closedById], references: [id])
  closedById        String?
  closedAt          DateTime?
  cashSalesCents    Int? // snapshots taken at close
  cashRefundsCents  Int?
  expectedCents     Int?
  countedCents      Int?
  overShortCents    Int? // counted − expected (negative = short)
  closeNote         String?

  @@index([registerId, openedAt])
}

// ─── Point of sale: card payments (Stripe Terminal) ──────────────────────────

enum CardCheckoutStatus {
  PENDING // waiting for the card on the reader (a decline leaves it PENDING with lastError)
  SUCCEEDED // card charged, sale not saved yet (or saving failed: lastError; retried)
  COMPLETING // a request is saving the sale right now (claimed so the register and webhook can't both save it)
  COMPLETED // sale saved (saleId)
  CANCELED // cancelled before the card was charged
}

// A sale waiting on a card payment. The register charges the card first (a card_present PaymentIntent
// processed on the register's reader); the sale is saved from `payload` once Stripe says it succeeded,
// by whichever comes first: the register polling or the payment_intent.succeeded webhook.
model CardCheckout {
  id                    String             @id @default(cuid())
  register              Register           @relation(fields: [registerId], references: [id])
  registerId            String
  cashier               Employee           @relation(fields: [cashierId], references: [id])
  cashierId             String
  status                CardCheckoutStatus @default(PENDING)
  amountCents           Int // charged to the card (the rest of a split sale is cash)
  stripePaymentIntentId String             @unique
  stripeReaderId        String
  payload               Json // create_sale arguments and follow-ups, built and validated before charging
  sale                  Sale?              @relation(fields: [saleId], references: [id])
  saleId                String?            @unique
  lastError             String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @default(now())

  @@index([registerId, createdAt])
}

// ─── Point of sale: member house accounts ────────────────────────────────────

enum HouseAccountStatus {
  ACTIVE
  SUSPENDED // can't charge; payments still accepted
  CLOSED
}

enum AccountEntryType {
  CHARGE // a sale charged to the account
  REFUND // a refund of an account sale back to the account
  PAYMENT // money in: cash/card at the register, online, autopay
  ADJUSTMENT // manual correction by an admin (either sign)
}

enum StatementStatus {
  OPEN // balance due
  PAID // paid in full (or nothing was due)
  AUTOPAY_FAILED // the autopay charge failed; the member is invoiced instead
}

// A member's charge account. The balance is the sum of the entries (positive = the member owes the course).
model HouseAccount {
  id                    String              @id @default(cuid())
  user                  User                @relation(fields: [userId], references: [id])
  userId                String              @unique
  status                HouseAccountStatus  @default(ACTIVE)
  creditLimitCents      Int                 @default(50000)
  // Member PIN for charging at the register (PBKDF2 hash). Locks after 5 wrong tries until an admin resets it.
  pinHash               String?
  pinFailedAttempts     Int                 @default(0)
  pinLockedAt           DateTime?
  // Autopay (opt-in by the member): statements are charged to the saved card
  autopayEnabled        Boolean             @default(false)
  stripeCustomerId      String?             @unique
  stripePaymentMethodId String?
  cardBrand             String?
  cardLast4             String?
  entries               HouseAccountEntry[]
  statements            Statement[]
  createdAt             DateTime            @default(now())
}

// The account ledger. Charges and refunds are written by create_sale() / refund_sale() in the same transaction as
// the sale; payments and adjustments by the API.
model HouseAccountEntry {
  id                    String           @id @default(cuid())
  account               HouseAccount     @relation(fields: [accountId], references: [id])
  accountId             String
  type                  AccountEntryType
  amountCents           Int // + adds to what the member owes (charges), − reduces it (payments, refunds, credits)
  description           String
  method                String? // payments: CASH | CARD | ONLINE | AUTOPAY
  sale                  Sale?            @relation(fields: [saleId], references: [id])
  saleId                String?
  refund                SaleRefund?      @relation(fields: [refundId], references: [id])
  refundId              String?
  register              Register?        @relation(fields: [registerId], references: [id])
  registerId            String? // payments taken at a register (cash goes in that drawer)
  stripePaymentIntentId String?          @unique
  createdById           String? // User.id of who recorded it (null = the member online, or the system)
  createdAt             DateTime         @default(now())

  @@index([accountId, createdAt])
  @@index([registerId, createdAt])
}

// A monthly statement. Amounts are snapshots taken when it was generated.
model Statement {
  id                     String          @id @default(cuid())
  account                HouseAccount    @relation(fields: [accountId], references: [id])
  accountId              String
  periodStart            DateTime        @db.Date
  periodEnd              DateTime        @db.Date
  openingCents           Int
  chargesCents           Int // charges in the period
  creditsCents           Int // payments, refunds and credits in the period (≤ 0)
  closingCents           Int
  dueDate                DateTime        @db.Date
  status                 StatementStatus @default(OPEN)
  emailedAt              DateTime?
  autopayPaymentIntentId String?         @unique
  autopayError           String?
  paidAt                 DateTime?
  createdAt              DateTime        @default(now())

  @@unique([accountId, periodStart])
}
